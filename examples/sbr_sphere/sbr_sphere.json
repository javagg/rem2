{
  // ─────────────────────────────────────────────────────────────────────────
  // rem  ·  SBR+ example: monostatic RCS of a PEC sphere
  //
  // Target: PEC sphere radius a = 0.5 m
  // Frequency: 3 GHz  →  ka = 2πfa/c = 2π·3e9·0.5/3e8 ≈ 31.4  (kα >> 1)
  // Incident:  θ_inc = 0°, φ_inc = 0°, θ-polarisation (broadside, +z)
  //
  // Expected: SBR+ monostatic RCS ≈ π a² = π × 0.25 ≈ 0.785 m²  (≈ −1.05 dBsm)
  // Mie exact at ka=31.4:  σ_mono ≈ π a² (optical limit)
  //
  // Mesh: UV-sphere, 24 latitude rings × 48 sectors ≈ 2304 faces
  //       generated by gen::pec_sphere_msh(0.5, 24, 48, 1)
  //
  // Run:  rem examples/sbr_sphere/sbr_sphere.json
  // Output: output/sbr_sphere/postpro/rcs_sbr.csv
  // ─────────────────────────────────────────────────────────────────────────

  "Problem": {
    "Type":    "SBR",
    "Verbose": 1,
    "Output":  "output/sbr_sphere"
  },

  "Model": {
    "Mesh": "examples/sbr_sphere/mesh/sphere.msh",
    "L0":   1.0
  },

  "Boundaries": {
    "PEC": { "Attributes": [1] }
  },

  "Solver": {
    "SBR": {
      "FreqMin":     3.0e9,
      "FreqMax":     3.0e9,
      "FreqStep":    0.0,
      "RayDensity":  5000.0,
      "MaxBounces":  3,
      "WeightThresh": 1e-4,
      "TargetType":  "PEC",
      "ThetaInc":    0.0,
      "PhiInc":      0.0,
      "Polarization": "theta"
    }
  },

  "Postprocessing": {
    "RCS": {
      "ThetaDeg": "0:5:180",
      "PhiDeg":   [0.0]
    }
  }
}
