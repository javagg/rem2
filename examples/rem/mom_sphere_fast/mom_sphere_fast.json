{
  "Problem": {
    "Type": "MoM",
    "Verbose": 1,
    "Output": "./output/rem_mom_sphere_fast"
  },
  "Model": {
    "Mesh": "examples/rem/sbr_sphere/mesh/sphere.msh",
    "L0": 1.0
  },
  "Boundaries": {
    "PEC": {
      "Attributes": [1]
    }
  },
  "Solver": {
    "MoM": {
      "Equation": "EFIE",
      "Basis": "Pulse",
      "FreqMin": 1.0e9,
      "FreqMax": 1.0e9,
      "FreqStep": 1.0,
      "Alpha": 0.5,
      "SingularTol": 5.0e-4,
      "FastSolver": "GMRES",
      "ThetaInc": 0.0,
      "PhiInc": 0.0,
      "Polarization": "theta"
    }
  },
  "Postprocessing": {
    "RCS": {
      "ThetaDeg": "0:30:180",
      "PhiDeg": [0.0]
    }
  }
}
