{
  // ─────────────────────────────────────────────────────────────────────────
  // rem  ·  Palace-compatible electrostatic configuration
  // Example: Coaxial cross-section (2-D analog of Palace "spheres" example)
  //
  // Palace reference:  https://awslabs.github.io/palace/stable/examples/spheres/
  //
  // Geometry (2-D, units = mm, L0 = 1e-3):
  //   Inner conductor  r_i = 1 mm  →  Terminal index 1  (φ = 1 V)
  //   Outer conductor  r_o = 4 mm  →  Ground            (φ = 0 V)
  //   Dielectric fill  ε_r = 1.0 (vacuum)
  //
  // Analytical results (per unit depth):
  //   φ(r) = ln(r_o / r) / ln(r_o / r_i)
  //   C/L  = 2π ε₀ / ln(r_o / r_i) ≈ 40.12 pF/m
  //
  // Palace "spheres" gives a 2×2 capacitance matrix for two spheres.
  // This 2-D coaxial case extracts the single self-capacitance of the same
  // Laplace problem and verifies against the above analytical formula.
  //
  // Mesh: generated by rem_mesh::gen::annular_msh(1.0, 4.0, 10, 32, 1, 2, 10)
  //       or provided as mesh/coaxial_2d.msh
  // ─────────────────────────────────────────────────────────────────────────

  "Problem": {
    "Type":    "Electrostatic",
    "Verbose": 1,
    "Output":  "./output/spheres"
  },

  "Model": {
    "Mesh": "examples/spheres/mesh/coaxial_2d.msh",
    "L0":   1.0e-3
  },

  "Domains": {
    "Materials": [
      {
        "Attributes":   [10],
        "Permittivity": 1.0,
        "Permeability": 1.0
      }
    ]
  },

  "Boundaries": {
    // Outer conductor grounded
    "Ground": { "Attributes": [2] },

    // Inner conductor excited at V = 1 V (Palace "Terminal" boundary)
    "Terminal": [
      {
        "Index":      1,
        "Attributes": [1]
      }
    ]
  },

  "Solver": {
    "Order": 1,
    "Linear": {
      "Type":    "GMRES",
      "Tol":     1.0e-10,
      "MaxIter": 500
    }
  }
}
