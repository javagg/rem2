{
  // ─────────────────────────────────────────────────────────────────────────
  // rem  ·  Palace-compatible magnetostatic configuration
  // Example: Two-layer bimaterial slab (2-D analog of Palace "rings" example)
  //
  // Palace reference:  https://awslabs.github.io/palace/v0.11/examples/rings/
  //
  // Geometry (2-D, units = mm, L0 = 1e-3):
  //   Domain:     1 mm × 1 mm square
  //   Lower half  (y ∈ [0, 0.5 mm])  :  iron, μ_r = 1000  (tag 10)
  //   Upper half  (y ∈ [0.5, 1 mm])  :  air,  μ_r = 1.0   (tag 20)
  //   Bottom edge (y = 0)   →  Ground         A_z = 0
  //   Top edge    (y = 1mm) →  SurfaceCurrent A_z = 1  (index 1)
  //   Left/Right  (x = 0,1) →  Neumann (natural BC, ∂A_z/∂n = 0)
  //
  // Analytical solution (series-reluctance model):
  //   ν_iron = 1 / (μ₀ × 1000),  ν_air = 1 / μ₀
  //   ν × ∂A_z/∂y = const  across the interface
  //   A_z(y=0.5 mm) = 1000 / 1001 ≈ 0.999001
  //   Gradient in iron:  ∂A_z/∂y = 2000 / (1001 H)  ≈  2000 / (1001 × 1e-3)
  //   Gradient in air:   ∂A_z/∂y = 2    / (1001 H)  ≈  2    / (1001 × 1e-3)
  //
  // Palace "rings" extracts the full 2×2 inductance matrix of two concentric
  // rings.  This 2-D slab problem tests the identical variable-permeability
  // assembly and verifies the interface jump condition.
  //
  // Mesh: generated by rem_mesh::gen::rect_bimaterial_msh(1.0, 1.0, 20, 20, 1, 2, 10, 20)
  //       or provided as mesh/slab_2d.msh
  // ─────────────────────────────────────────────────────────────────────────

  "Problem": {
    "Type":    "Magnetostatic",
    "Verbose": 1,
    "Output":  "./output/rings"
  },

  "Model": {
    "Mesh": "examples/rings/mesh/slab_2d.msh",
    "L0":   1.0e-3
  },

  "Domains": {
    "Materials": [
      {
        // Iron (lower half)
        "Attributes":   [10],
        "Permittivity": 1.0,
        "Permeability": 1000.0
      },
      {
        // Air (upper half)
        "Attributes":   [20],
        "Permittivity": 1.0,
        "Permeability": 1.0
      }
    ]
  },

  "Boundaries": {
    // Bottom edge: A_z = 0
    "Ground": { "Attributes": [1] },

    // Top edge: A_z = 1 (excitation current sheet)
    "SurfaceCurrent": [
      {
        "Index":      1,
        "Attributes": [2],
        "Direction":  "+Y"
      }
    ]
  },

  "Solver": {
    "Order": 1,
    "Linear": {
      "Type":    "GMRES",
      "Tol":     1.0e-10,
      "MaxIter": 500
    }
  }
}
